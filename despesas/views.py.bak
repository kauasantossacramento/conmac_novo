@login_required
def atividades_home(request):
    """
    View principal da home de atividades com ordenação FIFO corrigida.
    """
    from django.utils.timezone import now
    from django.db.models import Max
    from datetime import datetime
    from .models import (
        Despesa, ChecklistItem, NivelChoices,
        ConfiguracaoNivel, AssociacaoUsuarioCliente, Cliente,
        Etapa, EtapaRegistro, EtapaRegistroStatus, UsuarioPerfil,
        SolicitacaoReabertura
    )

    # Imports de forms (com tratamento de erro)
    try:
        from .forms import ChecklistForm, EtapaForm
    except ImportError:
        ChecklistForm = None
        EtapaForm = None

    user = request.user

    # A. Configurações Globais (Bypass)
    try:
        raw_liberados = ConfiguracaoNivel.objects.filter(
            liberar_preenchimento=True
        ).values_list('nivel', flat=True)
        niveis_liberados_global = [str(n).strip() for n in raw_liberados]
    except Exception:
        niveis_liberados_global = []

    # B. Dashboard Pessoal
    despesas_user = Despesa.objects.filter(usuario=user)
    tem_aprovadas = despesas_user.filter(status=Despesa.Status.APROVADA).exists()

    checklist_form = ChecklistForm() if ChecklistForm else None
    checklist_pendentes = ChecklistItem.objects.filter(
        usuario=user, concluido=False
    ).order_by("-criado_em")[:20]

    # C. Filtros da URL
    sel_ano_str = request.GET.get("ano")
    sel_mes_str = request.GET.get("mes")
    try:
        sel_ano = int(sel_ano_str) if sel_ano_str else None
        sel_mes = int(sel_mes_str) if sel_mes_str else None
    except ValueError:
        sel_ano, sel_mes = None, None

    nivel_sel_raw = request.GET.get("nivel")
    nivel_sel = str(nivel_sel_raw).strip() if (
        nivel_sel_raw and nivel_sel_raw in dict(NivelChoices.choices)
    ) else None

    # D. Menu Superior
    ICON_MAP = {
        "FECHAMENTO": "ic_fechamento.svg",
        "SIGA": "ic_siga.svg",
        "E-TCM": "ic_etcm.svg",
        "SIOPE": "ic_siope.svg",
        "SIOPS": "ic_siops.svg",
        "SICONF": "ic_siconf.svg",
    }

    niveis_menu = []

    def check_perm(u, key):
        if u.is_superuser:
            return True
        p = getattr(u, 'perfil', None)
        if not p:
            return False
        mapa = {
            "FECHAMENTO": p.acesso_fechamento,
            "SIGA": p.acesso_siga,
            "E-TCM": p.acesso_etcm,
            "SIOPE": p.acesso_siope,
            "SIOPS": p.acesso_siops,
            "SICONF": p.acesso_siconf,
        }
        return mapa.get(key, False)

    for val, label in NivelChoices.choices:
        if check_perm(user, val):
            niveis_menu.append({
                "key": val,
                "label": label,
                "icon": ICON_MAP.get(val, "ic_default.svg"),
                "is_active": (val == nivel_sel),
                "liberado_preenchimento": (val in niveis_liberados_global)
            })

    # E. Processamento de Clientes
    clientes_data = []

    if nivel_sel and sel_ano and sel_mes:
        assoc_ids = AssociacaoUsuarioCliente.objects.filter(
            usuario=user, ativo=True
        ).values_list("cliente_id", flat=True)

        clientes_qs = Cliente.objects.filter(
            id__in=assoc_ids, ativo=True
        ).order_by("nome")

        etapas_do_nivel = Etapa.objects.filter(nivel=nivel_sel, ativa=True)
        total_etapas = etapas_do_nivel.count()

        bypass_ativo = (nivel_sel in niveis_liberados_global)

        for c in clientes_qs:
            # 1. VERIFICAÇÃO DE BLOQUEIO
            data_entrada_fila = datetime.max  # Default: fim da fila (ano 9999)

            if bypass_ativo:
                is_desbloqueado = True
                data_entrada_fila = datetime.min  # Topo da fila (ano 0001)
            else:
                # CORREÇÃO: Chamada corrigida para a função unificada
                # A função retorna (bool, lista). Pegamos o bool [0].
                resultado_verificacao = verificar_nivel_desbloqueado(
                    c, sel_ano, sel_mes, nivel_sel
                )
                is_desbloqueado = resultado_verificacao[0]

                # Se desbloqueado, calcula data de entrada na fila
                if is_desbloqueado:
                    # Mapeia para saber quais etapas buscar
                    mapa_obrigatoriedade = {
                        "SIGA": "obrigatoria_para_fila_siga",
                        "E-TCM": "obrigatoria_para_fila_etcm",
                        "SIOPE": "obrigatoria_para_fila_siope",
                        "SIOPS": "obrigatoria_para_fila_siops",
                        "SICONF": "obrigatoria_para_fila_siconf",
                    }
                    campo_filtro = mapa_obrigatoriedade.get(str(nivel_sel))

                    if campo_filtro:
                        # Busca a data da última conclusão dos requisitos
                        etapas_req = Etapa.objects.filter(ativa=True, **{campo_filtro: True})
                        ultima_conclusao = EtapaRegistro.objects.filter(
                            cliente=c,
                            ano=sel_ano,
                            mes=sel_mes,
                            etapa__in=etapas_req,
                            status=EtapaRegistroStatus.CONCLUIDO
                        ).aggregate(Max('modificado_em'))['modificado_em__max']

                        if ultima_conclusao:
                            data_entrada_fila = ultima_conclusao

            if not is_desbloqueado:
                continue  # Oculta cliente bloqueado

            # 2. CONTAGEM DE PROGRESSO
            concluidas_count = EtapaRegistro.objects.filter(
                cliente=c,
                ano=sel_ano,
                mes=sel_mes,
                etapa__in=etapas_do_nivel,
                status=EtapaRegistroStatus.CONCLUIDO
            ).count()

            # 3. VERIFICAÇÃO DE ATIVIDADE (Status Em Andamento)
            tem_atividade = EtapaRegistro.objects.filter(
                cliente=c,
                ano=sel_ano,
                mes=sel_mes,
                etapa__in=etapas_do_nivel
            ).exclude(status=EtapaRegistroStatus.NAO_INICIADO).exists()

            # 4. DEFINIÇÃO DE STATUS E PESO
            status_geral = "Não iniciado"
            peso_status = 1

            if total_etapas == 0:
                status_geral = "Sem etapas"
                peso_status = 3
            elif concluidas_count >= total_etapas and total_etapas > 0:
                status_geral = "Concluído"
                peso_status = 2  # Fim da fila
            elif tem_atividade:
                status_geral = "Em andamento"
                peso_status = 0  # Topo absoluto (já iniciou trabalho)
            else:
                status_geral = "Não iniciado"
                peso_status = 1  # Fila de espera (ordena por data de entrada)

            # 5. DADOS DO ÚLTIMO EDITOR
            ultimo_reg = EtapaRegistro.objects.filter(
                cliente=c,
                ano=sel_ano,
                mes=sel_mes,
                etapa__in=etapas_do_nivel
            ).select_related('ultima_alteracao_por').order_by('-modificado_em').first()

            editor_nome = None
            data_alteracao_atual = None
            if ultimo_reg:
                data_alteracao_atual = ultimo_reg.modificado_em
                if ultimo_reg.ultima_alteracao_por:
                    editor_nome = (
                        ultimo_reg.ultima_alteracao_por.get_full_name() or
                        ultimo_reg.ultima_alteracao_por.username
                    )

            clientes_data.append({
                "cliente": c,
                "qtd_etapas": total_etapas,
                "qtd_concluidas": concluidas_count,
                "status_geral": status_geral,
                "ultimo_editor": editor_nome,
                "ultima_data": data_alteracao_atual,
                "peso_status": peso_status,
                "data_entrada_fila": data_entrada_fila
            })

        # --- F. ORDENAÇÃO FINAL (FIFO) ---
        clientes_data.sort(key=lambda x: (
            x['peso_status'],        # 1. Status (Em andamento primeiro)
            x['data_entrada_fila'],  # 2. Quem liberou requisitos antes
            x['cliente'].nome        # 3. Alfabética
        ))

    # G. Admin e Contexto
    gestao_etapas_dict = {}
    solicitacoes_pendentes = []
    qtd_solicitacoes = 0

    if user.is_staff or user.is_superuser:
        todas_etapas = Etapa.objects.all().order_by('nivel', 'ordem')
        for nivel, _ in NivelChoices.choices:
            gestao_etapas_dict[nivel] = todas_etapas.filter(nivel=nivel)

        try:
            solicitacoes_pendentes = SolicitacaoReabertura.objects.filter(
                status='PENDENTE'
            )
            qtd_solicitacoes = solicitacoes_pendentes.count()
        except:
            pass

    context = {
        "tem_aprovadas": tem_aprovadas,
        "checklist_form": checklist_form,
        "checklist_pendentes": checklist_pendentes,
        "sel_ano": sel_ano,
        "sel_mes": sel_mes,
        "nivel_sel": nivel_sel,
        "niveis": niveis_menu,
        "clientes_data": clientes_data,
        "gestao_etapas_dict": gestao_etapas_dict,
        "NivelChoices": NivelChoices,
        "solicitacoes_pendentes": solicitacoes_pendentes,
        "qtd_solicitacoes": qtd_solicitacoes,
        "form_etapa": EtapaForm() if EtapaForm else None,
        "niveis_liberados_global": niveis_liberados_global,
        "meses_numeros": range(1, 13),
    }

    return render(request, "atividades/home.html", context)
'''

@login_required
def atividades_home(request):
    """
    View principal da home de atividades com ordenação FIFO.
    ATUALIZADA: Suporte a liberação por cliente específico.
    """
    from django.utils.timezone import now
    from django.db.models import Max
    from datetime import datetime
    from .models import (
        Despesa, ChecklistItem, NivelChoices,
        ConfiguracaoNivel, AssociacaoUsuarioCliente, Cliente,
        Etapa, EtapaRegistro, EtapaRegistroStatus, UsuarioPerfil,
        SolicitacaoReabertura
    )

    try:
        from .forms import ChecklistForm, EtapaForm
    except ImportError:
        ChecklistForm = None
        EtapaForm = None

    user = request.user

    # A. Configurações Globais (ATUALIZADO)
    # Agora precisamos considerar clientes específicos
    niveis_info = {}
    try:
        configs = ConfiguracaoNivel.objects.all().prefetch_related('clientes_liberados')
        for config in configs:
            niveis_info[config.nivel] = {
                'liberado_global': config.liberar_preenchimento and not config.clientes_liberados.exists(),
                'tem_restricao': config.liberar_preenchimento and config.clientes_liberados.exists(),
                'config_obj': config
            }
    except Exception as e:
        print(f"Erro ao carregar configurações: {e}")
        niveis_info = {}

    # B. Dashboard Pessoal (mantém)
    despesas_user = Despesa.objects.filter(usuario=user)
    tem_aprovadas = despesas_user.filter(status=Despesa.Status.APROVADA).exists()

    checklist_form = ChecklistForm() if ChecklistForm else None
    checklist_pendentes = ChecklistItem.objects.filter(
        usuario=user, concluido=False
    ).order_by("-criado_em")[:20]

    # C. Filtros da URL (mantém)
    sel_ano_str = request.GET.get("ano")
    sel_mes_str = request.GET.get("mes")
    try:
        sel_ano = int(sel_ano_str) if sel_ano_str else None
        sel_mes = int(sel_mes_str) if sel_mes_str else None
    except ValueError:
        sel_ano, sel_mes = None, None

    nivel_sel_raw = request.GET.get("nivel")
    nivel_sel = str(nivel_sel_raw).strip() if (
        nivel_sel_raw and nivel_sel_raw in dict(NivelChoices.choices)
    ) else None

    # D. Menu Superior (ATUALIZADO)
    ICON_MAP = {
        "FECHAMENTO": "ic_fechamento.svg",
        "SIGA": "ic_siga.svg",
        "E-TCM": "ic_etcm.svg",
        "SIOPE": "ic_siope.svg",
        "SIOPS": "ic_siops.svg",
        "SICONF": "ic_siconf.svg",
    }

    niveis_menu = []

    def check_perm(u, key):
        if u.is_superuser:
            return True
        p = getattr(u, 'perfil', None)
        if not p:
            return False
        mapa = {
            "FECHAMENTO": p.acesso_fechamento,
            "SIGA": p.acesso_siga,
            "E-TCM": p.acesso_etcm,
            "SIOPE": p.acesso_siope,
            "SIOPS": p.acesso_siops,
            "SICONF": p.acesso_siconf,
        }
        return mapa.get(key, False)

    for val, label in NivelChoices.choices:
        if check_perm(user, val):
            info = niveis_info.get(val, {})
            niveis_menu.append({
                "key": val,
                "label": label,
                "icon": ICON_MAP.get(val, "ic_default.svg"),
                "is_active": (val == nivel_sel),
                "liberado_preenchimento": info.get('liberado_global', False),
                "tem_restricao_cliente": info.get('tem_restricao', False)
            })

    # E. Processamento de Clientes (ATUALIZADO)
    clientes_data = []

    if nivel_sel and sel_ano and sel_mes:
        assoc_ids = AssociacaoUsuarioCliente.objects.filter(
            usuario=user, ativo=True
        ).values_list("cliente_id", flat=True)

        clientes_qs = Cliente.objects.filter(
            id__in=assoc_ids, ativo=True
        ).order_by("nome")

        etapas_do_nivel = Etapa.objects.filter(nivel=nivel_sel, ativa=True)
        total_etapas = etapas_do_nivel.count()

        # ATUALIZADO: Pega info do nível
        info_nivel = niveis_info.get(nivel_sel, {})

        for c in clientes_qs:
            # 1. VERIFICAÇÃO DE BLOQUEIO (ATUALIZADO)
            data_entrada_fila = datetime.max

            # Verifica liberação global
            if info_nivel.get('liberado_global', False):
                is_desbloqueado = True
                data_entrada_fila = datetime.min
            # Verifica liberação por cliente específico
            elif info_nivel.get('tem_restricao', False):
                config_obj = info_nivel.get('config_obj')
                if config_obj and config_obj.esta_liberado_para_cliente(c):
                    is_desbloqueado = True
                    data_entrada_fila = datetime.min
                else:
                    # Cliente não está na lista de liberados
                    is_desbloqueado, _ = verificar_nivel_desbloqueado(c, sel_ano, sel_mes, nivel_sel)

                    if is_desbloqueado:
                        # Calcula data de entrada por requisitos
                        mapa_obrigatoriedade = {
                            "SIGA": "obrigatoria_para_fila_siga",
                            "E-TCM": "obrigatoria_para_fila_etcm",
                            "SIOPE": "obrigatoria_para_fila_siope",
                            "SIOPS": "obrigatoria_para_fila_siops",
                            "SICONF": "obrigatoria_para_fila_siconf",
                        }
                        campo_filtro = mapa_obrigatoriedade.get(str(nivel_sel))

                        if campo_filtro:
                            etapas_req = Etapa.objects.filter(ativa=True, **{campo_filtro: True})
                            ultima_conclusao = EtapaRegistro.objects.filter(
                                cliente=c,
                                ano=sel_ano,
                                mes=sel_mes,
                                etapa__in=etapas_req,
                                status=EtapaRegistroStatus.CONCLUIDO
                            ).aggregate(Max('modificado_em'))['modificado_em__max']

                            if ultima_conclusao:
                                data_entrada_fila = ultima_conclusao
            else:
                # Sem configuração especial, usa lógica de requisitos
                is_desbloqueado, _ = verificar_nivel_desbloqueado(c, sel_ano, sel_mes, nivel_sel)

                if is_desbloqueado:
                    mapa_obrigatoriedade = {
                        "SIGA": "obrigatoria_para_fila_siga",
                        "E-TCM": "obrigatoria_para_fila_etcm",
                        "SIOPE": "obrigatoria_para_fila_siope",
                        "SIOPS": "obrigatoria_para_fila_siops",
                        "SICONF": "obrigatoria_para_fila_siconf",
                    }
                    campo_filtro = mapa_obrigatoriedade.get(str(nivel_sel))

                    if campo_filtro:
                        etapas_req = Etapa.objects.filter(ativa=True, **{campo_filtro: True})
                        ultima_conclusao = EtapaRegistro.objects.filter(
                            cliente=c,
                            ano=sel_ano,
                            mes=sel_mes,
                            etapa__in=etapas_req,
                            status=EtapaRegistroStatus.CONCLUIDO
                        ).aggregate(Max('modificado_em'))['modificado_em__max']

                        if ultima_conclusao:
                            data_entrada_fila = ultima_conclusao

            if not is_desbloqueado:
                continue

            # 2. CONTAGEM DE PROGRESSO (mantém)
            concluidas_count = EtapaRegistro.objects.filter(
                cliente=c,
                ano=sel_ano,
                mes=sel_mes,
                etapa__in=etapas_do_nivel,
                status=EtapaRegistroStatus.CONCLUIDO
            ).count()

            # 3. VERIFICAÇÃO DE ATIVIDADE (mantém)
            tem_atividade = EtapaRegistro.objects.filter(
                cliente=c,
                ano=sel_ano,
                mes=sel_mes,
                etapa__in=etapas_do_nivel
            ).exclude(status=EtapaRegistroStatus.NAO_INICIADO).exists()

            # 4. DEFINIÇÃO DE STATUS E PESO (mantém)
            status_geral = "Não iniciado"
            peso_status = 1

            if total_etapas == 0:
                status_geral = "Sem etapas"
                peso_status = 3
            elif concluidas_count >= total_etapas and total_etapas > 0:
                status_geral = "Concluído"
                peso_status = 2
            elif tem_atividade:
                status_geral = "Em andamento"
                peso_status = 0
            else:
                status_geral = "Não iniciado"
                peso_status = 1

            # 5. DADOS DO ÚLTIMO EDITOR (mantém)
            ultimo_reg = EtapaRegistro.objects.filter(
                cliente=c,
                ano=sel_ano,
                mes=sel_mes,
                etapa__in=etapas_do_nivel
            ).select_related('ultima_alteracao_por').order_by('-modificado_em').first()

            editor_nome = None
            data_alteracao_atual = None
            if ultimo_reg:
                data_alteracao_atual = ultimo_reg.modificado_em
                if ultimo_reg.ultima_alteracao_por:
                    editor_nome = (
                        ultimo_reg.ultima_alteracao_por.get_full_name() or
                        ultimo_reg.ultima_alteracao_por.username
                    )

            clientes_data.append({
                "cliente": c,
                "qtd_etapas": total_etapas,
                "qtd_concluidas": concluidas_count,
                "status_geral": status_geral,
                "ultimo_editor": editor_nome,
                "ultima_data": data_alteracao_atual,
                "peso_status": peso_status,
                "data_entrada_fila": data_entrada_fila
            })

        # F. ORDENAÇÃO FINAL (mantém)
        clientes_data.sort(key=lambda x: (
            x['peso_status'],
            x['data_entrada_fila'],
            x['cliente'].nome
        ))

    # G. Admin e Contexto (ATUALIZADO)
    gestao_etapas_dict = {}
    solicitacoes_pendentes = []
    qtd_solicitacoes = 0
    todos_clientes = []  # NOVO: Para seleção no modal

    if user.is_staff or user.is_superuser:
        todas_etapas = Etapa.objects.all().order_by('nivel', 'ordem')
        for nivel, _ in NivelChoices.choices:
            gestao_etapas_dict[nivel] = todas_etapas.filter(nivel=nivel)

        try:
            solicitacoes_pendentes = SolicitacaoReabertura.objects.filter(
                status='PENDENTE'
            )
            qtd_solicitacoes = solicitacoes_pendentes.count()
        except:
            pass

        # NOVO: Lista todos os clientes para seleção
        todos_clientes = Cliente.objects.filter(ativo=True).order_by('nome')

    context = {
        "tem_aprovadas": tem_aprovadas,
        "checklist_form": checklist_form,
        "checklist_pendentes": checklist_pendentes,
        "sel_ano": sel_ano,
        "sel_mes": sel_mes,
        "nivel_sel": nivel_sel,
        "niveis": niveis_menu,
        "clientes_data": clientes_data,
        "gestao_etapas_dict": gestao_etapas_dict,
        "NivelChoices": NivelChoices,
        "solicitacoes_pendentes": solicitacoes_pendentes,
        "qtd_solicitacoes": qtd_solicitacoes,
        "form_etapa": EtapaForm() if EtapaForm else None,
        "niveis_info": niveis_info,  # NOVO
        "todos_clientes": todos_clientes,  # NOVO
        "meses_numeros": range(1, 13),
    }

    return render(request, "atividades/home.html", context)


def check_global_requirements(cliente, ano, mes, nivel_alvo):
    """
    Verifica a soma de todos os requisitos globais para um nível.
    Retorna: (bool: apto_para_concluir, list: pendencias, datetime: data_liberacao)
    """
    from .models import Etapa, EtapaRegistro, EtapaRegistroStatus
    from django.db.models import Max
    from datetime import datetime

    nivel_str = str(nivel_alvo).strip()

    # Mapeamento de campos de trava no Model Etapa
    mapa_campos = {
        "SIGA": "obrigatoria_para_fila_siga",
        "E-TCM": "obrigatoria_para_fila_etcm",
        "SIOPE": "obrigatoria_para_fila_siope",
        "SIOPS": "obrigatoria_para_fila_siops",
        "SICONF": "obrigatoria_para_fila_siconf",
    }

    campo_trava = mapa_campos.get(nivel_str)

    # Níveis sem requisitos (ex: FECHAMENTO) ou não mapeados
    if not campo_trava:
        return True, [], datetime.min

    # 1. Busca TODAS as etapas do sistema (qualquer nível) que travam o nível_alvo
    etapas_obrigatorias = Etapa.objects.filter(ativa=True, **{campo_trava: True})

    if not etapas_obrigatorias.exists():
        return True, [], datetime.min

    # 2. Verifica quais dessas etapas foram concluídas
    registros_concluidos = EtapaRegistro.objects.filter(
        cliente=cliente, ano=ano, mes=mes,
        etapa__in=etapas_obrigatorias,
        status=EtapaRegistroStatus.CONCLUIDO
    )

    ids_obrigatorios = set(etapas_obrigatorias.values_list('id', flat=True))
    ids_concluidos = set(registros_concluidos.values_list('etapa_id', flat=True))

    ids_pendentes = ids_obrigatorios - ids_concluidos

    if not ids_pendentes:
        # Se liberado, retorna a data da última conclusão para a lógica de Fila FIFO
        data_liberacao = registros_concluidos.aggregate(Max('modificado_em'))['modificado_em__max'] or datetime.min
        return True, [], data_liberacao

    # 3. Retorna nomes das pendências para o template
    nomes_pendentes = list(Etapa.objects.filter(id__in=ids_pendentes).values_list('nome', flat=True))
    return False, nomes_pendentes, datetime.max



def check_requirements_logic(cliente, ano, mes, nivel_alvo):
    """
    Retorna (True, []) se estiver tudo ok.
    Retorna (False, ['Etapa A', 'Etapa B']) se houver pendências.
    """
    from .models import Etapa, EtapaRegistro, EtapaRegistroStatus

    nivel_str = str(nivel_alvo).upper().strip()

    # Mapeamento dos campos booleanos no model Etapa
    mapa_campos = {
        "SIGA": "obrigatoria_para_fila_siga",
        "E-TCM": "obrigatoria_para_fila_etcm",
        "SIOPE": "obrigatoria_para_fila_siope",
        "SIOPS": "obrigatoria_para_fila_siops",
        "SICONF": "obrigatoria_para_fila_siconf",
    }

    campo_filtro = mapa_campos.get(nivel_str)
    if not campo_filtro:
        return True, []

    # 1. Busca TODAS as etapas que possuem a flag de trava para este nível alvo
    etapas_obrigatorias = Etapa.objects.filter(ativa=True, **{campo_filtro: True})

    if not etapas_obrigatorias.exists():
        return True, []

    # 2. Verifica quais dessas foram concluídas pelo cliente nesta competência
    ids_exigidos = set(etapas_obrigatorias.values_list('id', flat=True))

    concluidas = set(EtapaRegistro.objects.filter(
        cliente=cliente, ano=ano, mes=mes,
        etapa_id__in=ids_exigidos,
        status=EtapaRegistroStatus.CONCLUIDO
    ).values_list('etapa_id', flat=True))

    ids_pendentes = ids_exigidos - concluidas

    if not ids_pendentes:
        return True, []

    # 3. Busca os nomes das etapas pendentes
    nomes_pendentes = list(Etapa.objects.filter(id__in=ids_pendentes).values_list('nome', flat=True))
    return False, nomes_pendentes

