#antiga
'''
@login_required
@require_POST
def salvar_configuracao_nivel(request):
    if not (request.user.is_staff or request.user.is_superuser):
        return JsonResponse({"ok": False, "error": "Permissão negada."}, status=403)

    # 1. Captura os dados brutos
    nivel = request.POST.get("nivel", "").strip()
    liberar_str = request.POST.get("liberar", "").lower().strip()

    # 2. Conversão explícita de String para Boolean
    # O JS envia "true" (string). Se o Python fizer bool("false"), dá True.
    # Por isso comparamos a string.
    liberar = (liberar_str == 'true')

    print(f"DEBUG SALVAR -> Nível: [{nivel}] | Recebido: [{liberar_str}] | Salvando: {liberar}")

    if nivel:
        try:
            # Importe aqui para garantir que está usando o modelo certo
            from .models import ConfiguracaoNivel

            conf, created = ConfiguracaoNivel.objects.update_or_create(
                nivel=nivel,
                defaults={'liberar_preenchimento': liberar}
            )
            print(f"DEBUG DB -> ID: {conf.id} | Salvo como: {conf.liberar_preenchimento}")

            return JsonResponse({"ok": True})
        except Exception as e:
            print(f"DEBUG ERRO -> {e}")
            return JsonResponse({"ok": False, "error": str(e)}, status=500)

    return JsonResponse({"ok": False, "error": "Dados inválidos."}, status=400)
'''

@login_required
@require_POST
def salvar_configuracao_nivel(request):
    """
    Salva configuração de liberação (global ou por cliente).
    ATUALIZADA: Suporte a clientes específicos.
    """
    if not (request.user.is_staff or request.user.is_superuser):
        return JsonResponse({"ok": False, "error": "Permissão negada."}, status=403)

    nivel = request.POST.get("nivel", "").strip()
    liberar_str = request.POST.get("liberar", "").lower().strip()
    clientes_ids = request.POST.getlist("clientes[]")  # NOVO: IDs dos clientes

    liberar = (liberar_str == 'true')

    print(f"DEBUG -> Nível: {nivel} | Liberar: {liberar} | Clientes: {clientes_ids}")

    if nivel:
        try:
            from .models import ConfiguracaoNivel, Cliente

            # Obtém ou cria a configuração
            conf, created = ConfiguracaoNivel.objects.get_or_create(
                nivel=nivel,
                defaults={'liberar_preenchimento': liberar}
            )

            # Atualiza o campo de liberação
            conf.liberar_preenchimento = liberar
            conf.save()

            # NOVO: Atualiza os clientes específicos
            if clientes_ids:
                # Valida e filtra clientes
                clientes = Cliente.objects.filter(id__in=clientes_ids, ativo=True)
                conf.clientes_liberados.set(clientes)
                print(f"DEBUG -> Clientes associados: {clientes.count()}")
            else:
                # Remove todos os clientes (liberação global)
                conf.clientes_liberados.clear()
                print(f"DEBUG -> Liberação GLOBAL (sem clientes específicos)")

            return JsonResponse({
                "ok": True,
                "mensagem": str(conf)
            })

        except Exception as e:
            print(f"DEBUG ERRO -> {e}")
            return JsonResponse({"ok": False, "error": str(e)}, status=500)

    return JsonResponse({"ok": False, "error": "Dados inválidos."}, status=400)


