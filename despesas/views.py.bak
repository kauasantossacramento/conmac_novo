                "registro": reg,
                "status_atual": reg.status if reg else EtapaRegistroStatus.NAO_INICIADO,
                "observacao": reg.observacao if reg else "",
                "historico_recente": list(reg.historico.all())[:5] if reg else []
            })

    # Bloqueio de Edição (Se Fechamento estiver concluído e user não for admin)
    # Reutilizando a lógica para verificar se o próprio nível atual está fechado
    fechado = False
    if nivel_sel == NivelChoices.FECHAMENTO and not bloqueado_msg:
         # Lógica customizada para saber se o fechamento em si está travado para edição
         etapas_obrig = Etapa.objects.filter(nivel=NivelChoices.FECHAMENTO, ativa=True, obrigatoria_para_fila_siga=True)
         if etapas_obrig.exists():
             concl = EtapaRegistro.objects.filter(cliente=cliente, ano=sel_ano, mes=sel_mes, etapa__in=etapas_obrig, status=EtapaRegistroStatus.CONCLUIDO).count()
             fechado = (concl >= etapas_obrig.count())

    pode_editar = (not fechado) or (user.is_staff or user.is_superuser)
    if bloqueado_msg: pode_editar = False

    context = {
        "cliente": cliente,
        "sel_ano": sel_ano,
        "sel_mes": sel_mes,
        "nivel_sel": nivel_sel,
        "nivel_label": nivel_label,
        "dados_tabela": dados_tabela,
        "bloqueado_msg": bloqueado_msg, # Variável chave para o template
        "fechado": fechado,
        "pode_editar": pode_editar,
        "EtapaRegistroStatus": EtapaRegistroStatus,
    }
    return render(request, "fechamento/cliente_detail.html", context)
