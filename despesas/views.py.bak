User = get_user_model()

@login_required
def etapa_alterar_status(request, registro_id):
    # Função auxiliar para garantir que o log saia no arquivo de erro do PythonAnywhere
    def force_log(msg):
        print(f"[DEBUG NOTIF] {msg}", file=sys.stderr, flush=True)

    if request.method != "POST":
        return HttpResponseBadRequest("POST required")

    usuario = request.user
    force_log(f"--- INICIO REQUISICAO ---")
    force_log(f"Usuário Logado: {usuario.username} (ID: {usuario.id})")

    # 1. Busca Registro
    reg = get_object_or_404(EtapaRegistro, id=registro_id)
    cliente = reg.cliente
    force_log(f"Cliente Alvo: {cliente.nome} (ID: {cliente.id})")

    # --- (Mantendo sua lógica de bloqueio de fechamento original aqui) ---
    # fechado = ...
    # if fechado ... return ...
    # --------------------------------------------------------------------

    # 2. Dados do POST
    novo_status = request.POST.get("status")
    observacao = request.POST.get("observacao", "").strip()

    antigo_status = reg.status
    antigo_obs = reg.observacao or ""

    force_log(f"Status: {antigo_status} -> {novo_status}")
    force_log(f"Obs: {antigo_obs} -> {observacao}")

    # 3. Salvar (Sempre salvamos para teste)
    EtapaHistorico.objects.create(
        registro=reg, alterado_por=usuario,
        status_anterior=antigo_status, status_novo=novo_status,
        observacao_anterior=antigo_obs, observacao_nova=observacao,
    )
    reg.status = novo_status
    if observacao:
        reg.observacao = observacao
    reg.ultima_alteracao_por = usuario
    reg.save()

    force_log("Registro salvo e histórico criado.")

    # --- 4. NOTIFICAÇÃO (FORÇADA - SEM IF DE MUDANÇA) ---
    ids_notificacoes = []

    # Busca Associações
    associacoes = AssociacaoUsuarioCliente.objects.filter(
        cliente=cliente,
        ativo=True
    )
    force_log(f"Total de vínculos no banco para este cliente: {associacoes.count()}")

    # Exclui quem está fazendo a ação
    qs_final = associacoes.exclude(usuario=usuario)
    force_log(f"Total de alvos (excluindo autor): {qs_final.count()}")

    usuarios_alvo = [a.usuario for a in qs_final]
    force_log(f"Lista de Alvos: {[u.username for u in usuarios_alvo]}")

    if not usuarios_alvo:
        force_log("!!! ALERTA: Lista de alvos vazia. Ninguém será notificado.")

    # Tenta criar no banco
    titulo_msg = f"Update: {cliente.nome}"
    link_dest = f"/fechamento/{cliente.id}/"

    for u in usuarios_alvo:
        try:
            notif = NotificacaoPush.objects.create(
                usuario_alvo=u,
                titulo=titulo_msg,
                mensagem=f"Alteração feita por {usuario.username}",
                link=link_dest,
                enviado=False
            )
            ids_notificacoes.append(notif.id)
            force_log(f"SUCESSO: Notificação ID {notif.id} gravada para {u.username}")
        except Exception as e:
            force_log(f"ERRO DE GRAVACAO para {u.username}: {e}")

    force_log(f"--- FIM REQUISICAO. Retornando IDs: {ids_notificacoes} ---")

    return JsonResponse({
        "ok": True,
        "registro_id": reg.id,
        "status": reg.status,
        "notificacoes_ids": ids_notificacoes # O JS vai ler isso
    })


