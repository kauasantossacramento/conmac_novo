def validar_requisitos_conclusao(registro, usuario):

    from .models import Etapa, EtapaRegistro, EtapaRegistroStatus, ConfiguracaoNivel

    logger.info("==== INICIANDO VALIDAÇÃO DE REQUISITOS ====")

    # Admin continua podendo tudo
    if usuario.is_staff or usuario.is_superuser:
        logger.info("Admin - bypass total.")
        return True, []

    # 🔥 NOVA REGRA:
    # Se liberar_preenchimento=True, bloquear conclusão SEM validar requisitos
    bypass = ConfiguracaoNivel.objects.filter(
        nivel=registro.etapa.nivel,
        liberar_preenchimento=True
    ).exists()

    if bypass:
        logger.warning("Nível liberado para preenchimento, mas conclusão bloqueada.")
        return False, ["Este nível está liberado apenas para preenchimento. Conclusão bloqueada."]

    mapa_flags = {
        "SIGA": "obrigatoria_para_fila_siga",
        "E-TCM": "obrigatoria_para_fila_etcm",
        "SIOPE": "obrigatoria_para_fila_siope",
        "SIOPS": "obrigatoria_para_fila_siops",
        "SICONF": "obrigatoria_para_fila_siconf",
    }

    campo_flag = mapa_flags.get(registro.etapa.nivel)

    if not campo_flag:
        return True, []

    etapas_exigidas = Etapa.objects.filter(
        ativa=True,
        **{campo_flag: True}
    )

    pendentes = []

    for etapa_req in etapas_exigidas:

        if etapa_req.id == registro.etapa.id:
            continue

        registro_req = EtapaRegistro.objects.filter(
            cliente=registro.cliente,
            etapa=etapa_req,
            ano=registro.ano,
            mes=registro.mes
        ).first()

        if not registro_req or registro_req.status != EtapaRegistroStatus.CONCLUIDO:
            pendentes.append(etapa_req.nome)

    if pendentes:
        return False, pendentes

    return True, []


def calcular_nivel_apto_conclusao(cliente, nivel_sel, ano, mes, usuario):

    from .models import (
        ConfiguracaoNivel,
        Etapa,
        EtapaRegistro,
        EtapaRegistroStatus
    )

    motivos_bloqueio = []

    # Admin pode tudo
    if usuario.is_staff or usuario.is_superuser:
        return True, []

    # 1️⃣ VERIFICA SE ESTÁ EM MODO PREENCHIMENTO
    bloqueado_por_config = ConfiguracaoNivel.objects.filter(
        nivel=nivel_sel,
        liberar_preenchimento=True
    ).exists()

    if bloqueado_por_config:
        motivos_bloqueio.append(
            "Este nível está liberado apenas para preenchimento. Conclusão bloqueada."
        )

    # 2️⃣ CALCULA REQUISITOS OBRIGATÓRIOS SEMPRE

    mapa_flags = {
        "SIGA": "obrigatoria_para_fila_siga",
        "E-TCM": "obrigatoria_para_fila_etcm",
        "SIOPE": "obrigatoria_para_fila_siope",
        "SIOPS": "obrigatoria_para_fila_siops",
        "SICONF": "obrigatoria_para_fila_siconf",
    }

    campo_flag = mapa_flags.get(nivel_sel)

    if campo_flag:

        etapas_exigidas = Etapa.objects.filter(
            ativa=True,
            **{campo_flag: True}
        )

        for etapa_req in etapas_exigidas:

            registro_req = EtapaRegistro.objects.filter(
                cliente=cliente,
                etapa=etapa_req,
                ano=ano,
                mes=mes
            ).first()

            if not registro_req or registro_req.status != EtapaRegistroStatus.CONCLUIDO:
                motivos_bloqueio.append(etapa_req.nome)

    # 3️⃣ DECIDE RESULTADO FINAL

    if motivos_bloqueio:
        return False, motivos_bloqueio

    return True, []
