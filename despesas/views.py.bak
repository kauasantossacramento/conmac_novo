def avaliar_bloqueio_conclusao(cliente, nivel, ano, mes, usuario):
    """
    Versão atualizada com suporte a liberação por cliente.
    """
    from .models import (
        ConfiguracaoNivel,
        Etapa,
        EtapaRegistro,
        EtapaRegistroStatus
    )

    motivos = []

    # Admin pode tudo
    if usuario.is_staff or usuario.is_superuser:
        return True, []

    # 1️⃣ Verifica configuração de liberação (atualizado)
    try:
        config = ConfiguracaoNivel.objects.get(nivel=nivel)
        if config.esta_liberado_para_cliente(cliente):
            return True, []
    except ConfiguracaoNivel.DoesNotExist:
        pass

    # 2️⃣ Verifica requisitos (mantém lógica original)
    mapa_flags = {
        "SIGA": "obrigatoria_para_fila_siga",
        "E-TCM": "obrigatoria_para_fila_etcm",
        "SIOPE": "obrigatoria_para_fila_siope",
        "SIOPS": "obrigatoria_para_fila_siops",
        "SICONF": "obrigatoria_para_fila_siconf",
    }

    campo_flag = mapa_flags.get(nivel)

    if campo_flag:
        etapas_exigidas = Etapa.objects.filter(
            ativa=True,
            **{campo_flag: True}
        )

        for etapa_req in etapas_exigidas:
            registro_req = EtapaRegistro.objects.filter(
                cliente=cliente,
                etapa=etapa_req,
                ano=ano,
                mes=mes
            ).first()

            if not registro_req or registro_req.status != EtapaRegistroStatus.CONCLUIDO:
                motivos.append(etapa_req.nome)

    if motivos:
        return False, motivos

    return True, []



@login_required
def fechamento_cliente_detail(request, cliente_id):
    """
    View de detalhamento de etapas de um cliente em um nível específico.
    Implementa bloqueio de conclusão baseado em pré-requisitos cross-module.
    """
    from django.shortcuts import get_object_or_404, render
    from django.http import HttpResponseForbidden
    from django.utils.timezone import now
    from django.db import models
    from .models import (
        Cliente, AssociacaoUsuarioCliente, NivelChoices, ConfiguracaoNivel,
        Etapa, EtapaRegistro, EtapaRegistroStatus, EtapaHistorico, SolicitacaoReabertura
    )

    user = request.user
    cliente = get_object_or_404(Cliente, id=cliente_id)

    # 1. Permissão de Acesso
    assoc = AssociacaoUsuarioCliente.objects.filter(usuario=user, cliente=cliente, ativo=True).exists()
    if not assoc and not (user.is_staff or user.is_superuser):
        return HttpResponseForbidden("Acesso negado")

    # 2. Filtros de Competência
    hoje = now()
    try:
        sel_ano = int(request.GET.get("ano", hoje.year))
        sel_mes = int(request.GET.get("mes", hoje.month))
    except (ValueError, TypeError):
        sel_ano, sel_mes = hoje.year, hoje.month

    # 3. Identificação e Validação do Nível Selecionado
    nivel_sel_raw = request.GET.get("nivel", "FECHAMENTO")
    nivel_sel = str(nivel_sel_raw).strip().upper()

    chaves_validas = [str(c[0]) for c in NivelChoices.choices]
    if nivel_sel not in chaves_validas:
        nivel_sel = "FECHAMENTO"

    nivel_label = dict(NivelChoices.choices).get(nivel_sel, nivel_sel)

    # --- LÓGICA DE BLOQUEIO / DESBLOQUEIO (SOMA DE REQUISITOS) ---

    # A. Verificação de Bypass Administrativo
    try:
        bypass_ativo = ConfiguracaoNivel.objects.filter(
            nivel=nivel_sel, liberar_preenchimento=True
        ).exists()
    except Exception:
        bypass_ativo = False


    nivel_apto_conclusao, lista_pendencias = avaliar_bloqueio_conclusao(
        cliente,
        nivel_sel,
        sel_ano,
        sel_mes,
        request.user
    )


    # --- CARREGAMENTO DE DADOS (ETAPAS E REGISTROS) ---
    etapas = list(Etapa.objects.filter(nivel=nivel_sel, ativa=True).order_by("ordem"))

    # Garante a existência de registros para todas as etapas do nível
    if etapas:
        existing = set(EtapaRegistro.objects.filter(
            cliente=cliente, ano=sel_ano, mes=sel_mes, etapa__in=etapas
        ).values_list('etapa_id', flat=True))

        novos = [
            EtapaRegistro(cliente=cliente, etapa=e, ano=sel_ano, mes=sel_mes, status=EtapaRegistroStatus.NAO_INICIADO)
            for e in etapas if e.id not in existing
        ]
        if novos:
            EtapaRegistro.objects.bulk_create(novos)

    # Recupera registros com histórico e informações de edição
    registros_qs = EtapaRegistro.objects.filter(
        cliente=cliente, ano=sel_ano, mes=sel_mes, etapa__in=etapas
    ).select_related('etapa', 'ultima_alteracao_por').prefetch_related(
        models.Prefetch('historico', queryset=EtapaHistorico.objects.order_by('-criado_em'))
    )
    registros_dict = {r.etapa_id: r for r in registros_qs}

    dados_tabela = []
    for etapa in etapas:
        reg = registros_dict.get(etapa.id)

        # Bloqueio Administrativo (Etapas já concluídas por não-admins)
        travado_admin = False
        if reg and reg.status == EtapaRegistroStatus.CONCLUIDO and not (user.is_staff or user.is_superuser):
            travado_admin = True

        solicitacao = None
        if reg:
            solicitacao = SolicitacaoReabertura.objects.filter(registro=reg).order_by('-data_solicitacao').first()

        dados_tabela.append({
            "etapa": etapa,
            "registro": reg,
            "status_atual": reg.status if reg else EtapaRegistroStatus.NAO_INICIADO,
            "observacao": reg.observacao if reg else "",
            "historico_recente": list(reg.historico.all())[:5] if reg else [],
            "travado_por_conclusao": travado_admin,
            "solicitacao_atual": solicitacao,
            # INFORMAÇÃO PARA O JS: Define se esta linha deve desabilitar o "Concluir" no modal
            "bloqueada_para_concluir": not nivel_apto_conclusao
        })
    lista_etapas = []
    lista_etapas = lista_pendencias
    context = {
        "cliente": cliente,
        "sel_ano": sel_ano,
        "sel_mes": sel_mes,
        "nivel_sel": nivel_sel,
        "nivel_label": nivel_label,
        "dados_tabela": dados_tabela,
        "nivel_apto_conclusao": nivel_apto_conclusao,
        "pendencias_nomes": lista_pendencias,
        "lista": lista_etapas,
        "pode_editar": True,
        "EtapaRegistroStatus": EtapaRegistroStatus,
    }

    return render(request, "fechamento/cliente_detail.html", context)


