from decimal import Decimal
from django.shortcuts import render, get_object_or_404, redirect
from django.contrib.auth.decorators import login_required, user_passes_test
from django.http import JsonResponse, HttpResponseForbidden, HttpResponseBadRequest, HttpResponse
from django.urls import reverse
from django.db.models import Count, Q, Sum
from django.utils.timezone import now
from django.core.paginator import Paginator
from django.views.decorators.http import require_GET, require_POST
from django.forms.models import model_to_dict

from .models import (
    Cliente, AssociacaoUsuarioCliente, Etapa, EtapaRegistro, EtapaHistorico,
    NivelChoices, EtapaRegistroStatus, FilaAutomatica
)

# Ajuste de permissão simples (faça sua lógica real se houver grupos/perfis)
def user_is_admin(user):
    return user.is_superuser or user.is_staff


@login_required
def fechamento_clientes_list(request):
    """
    Lista os clientes vinculados ao usuário com status de FECHAMENTO resumido.
    Filtro por mes/ano (GET).
    """
    user = request.user
    assoc_ids = AssociacaoUsuarioCliente.objects.filter(usuario=user, ativo=True).values_list("cliente_id", flat=True)
    clientes_qs = Cliente.objects.filter(id__in=assoc_ids, ativo=True).order_by("nome")

    # período
    hoje = now()
    sel_ano = request.GET.get("ano")
    sel_mes = request.GET.get("mes")
    try:
        sel_ano = int(sel_ano) if sel_ano not in (None, "", "0") else hoje.year
    except ValueError:
        sel_ano = hoje.year
    try:
        sel_mes = int(sel_mes) if sel_mes not in (None, "", "0") else hoje.month
    except ValueError:
        sel_mes = hoje.month

    clientes_data = []
    etapas_fech = Etapa.objects.filter(nivel=NivelChoices.FECHAMENTO, ativa=True).order_by("ordem")
    etapas_obrig = etapas_fech.filter(Q(obrigatoria_para_fila_siga=True) | Q(obrigatoria_para_fila_etcm=True))
    etapas_consideradas = etapas_obrig if etapas_obrig.exists() else etapas_fech

    for c in clientes_qs:
        total_etapas = etapas_consideradas.count()
        regs = EtapaRegistro.objects.filter(cliente=c, ano=sel_ano, mes=sel_mes, etapa__in=etapas_consideradas)
        qtd_concl = regs.filter(status=EtapaRegistroStatus.CONCLUIDO).count()
        qtd_pendente = regs.filter(status=EtapaRegistroStatus.PENDENTE).count()
        ultima_data = regs.order_by("-modificado_em").first().modificado_em if regs.exists() else None

        if total_etapas == 0:
            status_geral = "Sem etapas"
        elif qtd_concl >= total_etapas:
            status_geral = "Concluído"
        elif regs.filter(status=EtapaRegistroStatus.EM_ANDAMENTO).exists():
            status_geral = "Em andamento"
        elif regs.exists():
            status_geral = "Iniciado"
        else:
            status_geral = "Não iniciado"

        clientes_data.append({
            "cliente": c,
            "total_etapas": total_etapas,
            "qtd_concluidas": qtd_concl,
            "qtd_pendente": qtd_pendente,
            "ultima_data": ultima_data,
            "status_geral": status_geral,
            "fechado": fechamento_esta_fechado(c, sel_ano, sel_mes),
        })

    context = {
        "clientes_data": clientes_data,
        "sel_ano": sel_ano,
        "sel_mes": sel_mes,
        "meses_numeros": [(i, f"{i:02d}") for i in range(1, 13)],
        "anos_disponiveis": sorted(list({r.ano for r in EtapaRegistro.objects.all()})) or [sel_ano],
    }
    return render(request, "fechamento/clientes_list.html", context)


