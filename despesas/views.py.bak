    # >>>> VERIFICAÇÃO DE BLOQUEIO <<<<
    bloqueado_msg = None
    dados_tabela = []

    if not verificar_nivel_desbloqueado(cliente, sel_ano, sel_mes, nivel_sel):
        bloqueado_msg = f"O nível {nivel_label} está bloqueado. Conclua as etapas obrigatórias no FECHAMENTO para liberar."
        # Não carrega etapas se estiver bloqueado
    else:
        # Se desbloqueado, carrega dados normalmente
