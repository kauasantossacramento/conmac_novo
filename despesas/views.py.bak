def _rotulo_filtro(ano: int, mes: int) -> str:
    if ano == 0 and mes == 0:
        return "TODOS"
    if ano == 0:
        return f"{mes_label_pt(2000, mes).split(' / ')[0]} / TODOS OS ANOS"  # só nome do mês
    if mes == 0:
        return f"TODOS / {ano}"
    return mes_label_pt(ano, mes)

@login_required
def home(request):
    return render(request, "home.html")

