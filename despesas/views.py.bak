from .models import EtapaHistorico # Adicione nos imports


from django.http import JsonResponse, HttpResponseBadRequest
from django.contrib.auth.decorators import login_required
from django.shortcuts import get_object_or_404
import sys

import sys # Import essencial para evitar o erro 502 no log
from django.contrib.auth.decorators import login_required
from django.views.decorators.http import require_POST
from django.http import JsonResponse, HttpResponseBadRequest
from django.shortcuts import get_object_or_404

def verificar_dependencias_etapas(cliente, nivel, ano, mes, etapa_em_edicao=None):
    """
    Verifica se existem etapas obrigatórias pendentes para liberar o nível informado.

    Retorna um QuerySet de Etapa pendentes.
    """

    from .models import Etapa, EtapaRegistro, EtapaRegistroStatus, NivelChoices

    mapa_obrigatoriedade = {
        NivelChoices.SIGA: "obrigatoria_para_fila_siga",
        NivelChoices.E_TCM: "obrigatoria_para_fila_etcm",
        NivelChoices.SIOPE: "obrigatoria_para_fila_siope",
        NivelChoices.SIOPS: "obrigatoria_para_fila_siops",
        NivelChoices.SICONF: "obrigatoria_para_fila_siconf",
    }

    campo_filtro = mapa_obrigatoriedade.get(nivel)

    # Se o nível não exige dependência (ex: FECHAMENTO)
    if not campo_filtro:
        return Etapa.objects.none()

    etapas_obrigatorias = Etapa.objects.filter(
        ativa=True,
        **{campo_filtro: True}
    )

    if not etapas_obrigatorias.exists():
        return Etapa.objects.none()

    ids_obrigatorias = set(
        etapas_obrigatorias.values_list("id", flat=True)
    )

    ids_concluidas = set(
        EtapaRegistro.objects.filter(
            cliente=cliente,
            ano=ano,
            mes=mes,
            etapa_id__in=ids_obrigatorias,
            status=EtapaRegistroStatus.CONCLUIDO
        ).values_list("etapa_id", flat=True)
    )

    pendentes_ids = ids_obrigatorias - ids_concluidas

    # Remove a própria etapa que está sendo editada (se houver)
    if etapa_em_edicao:
        pendentes_ids.discard(etapa_em_edicao.id)

    return Etapa.objects.filter(id__in=pendentes_ids)

@login_required
@require_POST
def atualizar_etapa_registro(request):

    from .models import (
        EtapaRegistro, EtapaHistorico, EtapaRegistroStatus,
        Cliente, Etapa, AssociacaoUsuarioCliente,
        NotificacaoPush
    )

    from django.shortcuts import get_object_or_404
    from django.http import JsonResponse
    from django.utils.timezone import now
    from django.contrib.auth import get_user_model
    from django.db.models import Q
    import logging

    logger = logging.getLogger(__name__)
    User = get_user_model()

    def safe_int(val):
        try:
            return int(val) if val else None
        except (ValueError, TypeError):
            return None

    logger.info("===== NOVA REQUISIÇÃO atualizar_etapa_registro =====")

    # ----------------------------
    # 1) CAPTURA
    # ----------------------------

    reg_id = safe_int(request.POST.get("registro_id"))
    etapa_id = safe_int(request.POST.get("etapa_id"))
    cliente_id = safe_int(request.POST.get("cliente_id"))
    novo_status = request.POST.get("status")
    observacao = request.POST.get("observacao", "")
    arquivo = request.FILES.get("arquivo_anexo")

    hoje = now()
    registro = None

    # ----------------------------
    # 2) LOCALIZAÇÃO / CRIAÇÃO
    # ----------------------------

    if reg_id:
        registro = EtapaRegistro.objects.select_related(
            "cliente", "etapa"
        ).filter(id=reg_id).first()

    elif etapa_id and cliente_id:
        cliente_obj = get_object_or_404(Cliente, id=cliente_id)
        etapa_obj = get_object_or_404(Etapa, id=etapa_id)

        registro, _ = EtapaRegistro.objects.get_or_create(
            cliente=cliente_obj,
            etapa=etapa_obj,
            ano=safe_int(request.POST.get("ano")) or hoje.year,
            mes=safe_int(request.POST.get("mes")) or hoje.month,
            defaults={"status": EtapaRegistroStatus.NAO_INICIADO}
        )

    if not registro:
        logger.error("Registro não identificado.")
        return JsonResponse({"ok": False, "error": "Registro não identificado."}, status=400)

    # ----------------------------
    # 3) VALIDAÇÃO DE CONCLUSÃO
    # ----------------------------

    if novo_status == EtapaRegistroStatus.CONCLUIDO:

        ok, pendencias = avaliar_bloqueio_conclusao(
            registro.cliente,
            registro.etapa.nivel,
            registro.ano,
            registro.mes,
            request.user
        )


        if not ok:
            logger.warning("Conclusão bloqueada.")
            return JsonResponse({
                "ok": False,
                "error": "Bloqueio de Requisitos",
                "pendencias": pendencias
            })

    # ----------------------------
    # 4) SALVAMENTO
    # ----------------------------

    status_anterior = registro.status
    obs_anterior = registro.observacao

    registro.status = novo_status
    registro.observacao = observacao
    registro.ultima_alteracao_por = request.user

    if arquivo:
        registro.arquivo_anexo = arquivo

    registro.save()

    logger.info(f"Registro salvo: {registro.cliente} | {registro.etapa.nome} | {registro.status}")

    # ----------------------------
    # 5) HISTÓRICO + NOTIFICAÇÕES
    # ----------------------------

    ids_notificacoes = []

    try:

        if status_anterior != registro.status or \
           obs_anterior != registro.observacao or \
           arquivo:

            # Histórico
            EtapaHistorico.objects.create(
                registro=registro,
                alterado_por=request.user,
                status_anterior=status_anterior,
                status_novo=registro.status,
                observacao_anterior=obs_anterior,
                observacao_nova=registro.observacao
            )

            logger.info("Histórico criado.")

            # Destinatários
            destinatarios = User.objects.filter(
                Q(is_staff=True) |
                Q(is_superuser=True) |
                Q(id__in=AssociacaoUsuarioCliente.objects.filter(
                    cliente=registro.cliente,
                    ativo=True
                ).values_list('usuario_id', flat=True))
            ).exclude(id=request.user.id).distinct()

            # Construção da mensagem
            competencia = f"{registro.mes:02d}/{registro.ano}"
            mensagem = (
                f"A Etapa {registro.etapa.nome} do {registro.etapa.nivel} possui um novo Status: {registro.get_status_display()} 😊"
            )

            notificacoes = []

            for dest in destinatarios:
                notificacoes.append(
                    NotificacaoPush(
                        usuario_alvo=dest,
                        titulo=f"ATUALIZAÇÃO EM {registro.cliente.nome} - {competencia} ⚠️",
                        mensagem=mensagem,
                        link=f"/fechamento/cliente/{registro.cliente.id}/?nivel={registro.etapa.nivel}&ano={registro.ano}&mes={registro.mes}",
                        enviado=False
                    )
                )

            if notificacoes:
                criadas = NotificacaoPush.objects.bulk_create(notificacoes)
                ids_notificacoes = [n.id for n in criadas]
                logger.info(f"{len(ids_notificacoes)} notificações criadas.")

    except Exception:
        logger.exception("Erro ao criar notificações.")

    # ----------------------------
    # 6) RESPOSTA FINAL
    # ----------------------------

    return JsonResponse({
        "ok": True,
        "message": "Salvo com sucesso!",
        "notificacoes_ids": ids_notificacoes
    })


from django.shortcuts import redirect, get_object_or_404
from django.contrib.auth.decorators import login_required
from django.http import JsonResponse, HttpResponseForbidden
from django.utils import timezone
from django.db.models import Count, Q
from .models import SolicitacaoReabertura, EtapaRegistro, EtapaRegistroStatus

@login_required
def solicitar_reabertura(request, registro_id):
    """Usuário comum solicita o desbloqueio de uma etapa concluída."""
    registro = get_object_or_404(EtapaRegistro, id=registro_id)

    # Verifica se já existe pendente
    if SolicitacaoReabertura.objects.filter(registro=registro, status='PENDENTE').exists():
        return redirect(request.META.get('HTTP_REFERER', '/'))

    SolicitacaoReabertura.objects.create(
        registro=registro,
        solicitante=request.user
    )
    return redirect(request.META.get('HTTP_REFERER', '/'))

@login_required
def gerenciar_solicitacao(request):
    """Admin aprova ou nega via POST."""
    if not (request.user.is_staff or request.user.is_superuser):
        return HttpResponseForbidden()

    if request.method == 'POST':
        solic_id = request.POST.get('solicitacao_id')
        acao = request.POST.get('acao') # 'APROVAR' ou 'NEGAR'
        motivo = request.POST.get('motivo', '')

        solic = get_object_or_404(SolicitacaoReabertura, id=solic_id)

        solic.analisado_por = request.user
        solic.data_analise = timezone.now()

        if acao == 'APROVAR':
            solic.status = 'APROVADO'

            registro = solic.registro

            # 1. Captura estado anterior para o histórico
            status_anterior = registro.status

            # 2. AÇÃO PRINCIPAL: Volta o status do registro para EM ANDAMENTO
            registro.status = EtapaRegistroStatus.EM_ANDAMENTO
            registro.save()

            # 3. CRIA O HISTÓRICO DA APROVAÇÃO
            # Isso garante que apareça na timeline "Quem" reabriu e "Quando"
            EtapaHistorico.objects.create(
                registro=registro,
                alterado_por=request.user,
                status_anterior=status_anterior,
                status_novo=EtapaRegistroStatus.EM_ANDAMENTO,
                observacao_anterior=registro.observacao,
                observacao_nova=f"Reabertura administrativa autorizada." # Mensagem automática no histórico
            )

        else:
            solic.status = 'NEGADO'
            solic.motivo_recusa = motivo

        solic.save()

    return redirect('atividades_home') # Volta para home após gerenciar

from django.shortcuts import get_object_or_404
from django.http import JsonResponse, HttpResponseBadRequest
from django.contrib.auth.decorators import login_required
from django.db.models import Q
# Importe seus models e choices aqui (Etapa, EtapaRegistro, etc.)

def fechamento_esta_fechado(cliente, ano, mes):
    """
    Mantido igual: Considera FECHAMENTO 'fechado' quando todas as etapas obrigatórias
    estão com status CONCLUIDO.
    """
    etapas_fech = Etapa.objects.filter(nivel=NivelChoices.FECHAMENTO, ativa=True)
    if not etapas_fech.exists():
        return False

    obrigatorias = etapas_fech.filter(Q(obrigatoria_para_fila_siga=True) | Q(obrigatoria_para_fila_etcm=True))
    etapas_consideradas = obrigatorias if obrigatorias.exists() else etapas_fech

    total_etapas = etapas_consideradas.count()
    concluidas = EtapaRegistro.objects.filter(
        cliente=cliente, ano=ano, mes=mes, etapa__in=etapas_consideradas,
        status=EtapaRegistroStatus.CONCLUIDO
    ).count()

    return total_etapas > 0 and concluidas >= total_etapas


def _label_status(status):
    mapping = {
        EtapaRegistroStatus.NAO_INICIADO: "Não iniciado",
        EtapaRegistroStatus.EM_ANDAMENTO: "Em andamento",
        EtapaRegistroStatus.CONCLUIDO: "Concluído",
        EtapaRegistroStatus.PENDENTE: "Pendente",
    }
    return mapping.get(status, status)

