# atividades/views.py

'''

#ANTERIOR - CONSIDERANDO A LÓGICA DE FECHAMENTO

@login_required
def atividades_home(request):
    user = request.user
    hoje = now()

    # 1. Filtros de Competência
    try: sel_ano = int(request.GET.get("ano", hoje.year))
    except: sel_ano = hoje.year
    try: sel_mes = int(request.GET.get("mes", hoje.month))
    except: sel_mes = hoje.month

    # 2. Nível Selecionado (AGORA SEM DEFAULT)
    # Se não vier na URL, fica None (tela limpa)
    nivel_sel = request.GET.get("nivel")

    # Validação: Se selecionado, deve ser válido
    if nivel_sel and nivel_sel not in dict(NivelChoices.choices):
        nivel_sel = None

    # 3. Montagem dos Cards (Menu Superior) COM FILTRO DE PERMISSÃO
    ICON_MAP = {
        "FECHAMENTO": "ic_fechamento.svg",
        "SIGA": "ic_siga.svg",
        "E-TCM": "ic_etcm.svg",
        "SIOPE": "ic_siope.svg",
        "SIOPS": "ic_siops.svg",
        "SICONF": "ic_siconf.svg",
    }

    # Tenta pegar o perfil (ou usa atributos diretos se for CustomUser)
    # Ajuste aqui conforme onde você criou os campos do Passo 1
    try:
        # O Django acessa o related_name definido no model
        perfil = user.perfil
    except AttributeError: # Caso o usuário não tenha perfil criado ainda
        perfil = None
    except UsuarioPerfil.DoesNotExist: # Caso user.perfil lance erro se não existir
        perfil = None

    def tem_permissao(nivel_key):
        if user.is_superuser: return True # Admin vê tudo
        if not perfil: return False # Sem perfil, não vê nada

        mapa = {
            "FECHAMENTO": perfil.acesso_fechamento,
            "SIGA": perfil.acesso_siga,
            "E-TCM": perfil.acesso_etcm,
            "SIOPE": perfil.acesso_siope,
            "SIOPS": perfil.acesso_siops,
            "SICONF": perfil.acesso_siconf,
        }
        return mapa.get(nivel_key, False)

    niveis = []
    for val, label in NivelChoices.choices:
        # Só adiciona na lista se tiver permissão
        if tem_permissao(val):
            niveis.append({
                "key": val,
                "label": label,
                "icon": ICON_MAP.get(val, "ic_default.svg"),
                "is_active": (val == nivel_sel),
            })

    # 4. Dados dos Clientes (SÓ BUSCA SE TIVER NÍVEL SELECIONADO)
    clientes_data = []

    if nivel_sel:
        assoc_ids = AssociacaoUsuarioCliente.objects.filter(usuario=user, ativo=True).values_list("cliente_id", flat=True)
        clientes_qs = Cliente.objects.filter(id__in=assoc_ids, ativo=True).order_by("nome")

        etapas_do_nivel = Etapa.objects.filter(nivel=nivel_sel, ativa=True)
        total_etapas = etapas_do_nivel.count()

        for c in clientes_qs:
            # Filtro Cachoeira
            if not verificar_nivel_desbloqueado(c, sel_ano, sel_mes, nivel_sel):
                continue

            concluidas = EtapaRegistro.objects.filter(cliente=c, ano=sel_ano, mes=sel_mes, etapa__in=etapas_do_nivel, status=EtapaRegistroStatus.CONCLUIDO).count()

            pendentes = EtapaRegistro.objects.filter(cliente=c, ano=sel_ano, mes=sel_mes, etapa__in=etapas_do_nivel, status=EtapaRegistroStatus.PENDENTE).count()

            # Status Texto Exato (Case Sensitive para o Template)
            if total_etapas == 0:
                status_geral = "Sem etapas"
            elif concluidas >= total_etapas:
                status_geral = "Concluído"
            elif concluidas > 0:
                status_geral = "Em andamento"
            else:
                status_geral = "Não iniciado"

            clientes_data.append({
                "cliente": c,
                "qtd_etapas": total_etapas,
                "qtd_concluidas": concluidas,
                "qtd_pendente": total_etapas - concluidas,
                "status_geral": status_geral,
            })

        # Ordenação por conclusão (Decrescente)
        clientes_data.sort(key=lambda x: x['qtd_concluidas'], reverse=True)

    context = {
        "sel_ano": sel_ano,
        "sel_mes": sel_mes,
        "nivel_sel": nivel_sel,
        "niveis": niveis,
        "clientes_data": clientes_data,
    }
    return render(request, "atividades/home.html", context)


'''
# despesas/views.py

# ... outros imports ...
from .models import Etapa, EtapaRegistro
from .forms import EtapaForm

from django.db.models import Max # <--- IMPORTANTE: Adicione este import no topo
'''
@login_required
def atividades_home(request):
    user = request.user

    # --- 1. DASHBOARD PESSOAL (Checklist e Despesas) ---
    # Necessário para que a home.html exiba os dados pessoais do usuário
    despesas_user = Despesa.objects.filter(usuario=request.user)
    tem_aprovadas = despesas_user.filter(status=Despesa.Status.APROVADA).exists()

    checklist_form = ChecklistForm()
    checklist_pendentes = ChecklistItem.objects.filter(usuario=request.user, concluido=False).order_by("-criado_em")[:20]

    # --- 2. FILTROS DE COMPETÊNCIA (Sem pré-seleção) ---
    # Se não vier na URL, define como None para obrigar a seleção
    sel_ano_str = request.GET.get("ano")
    sel_mes_str = request.GET.get("mes")

    sel_ano = int(sel_ano_str) if sel_ano_str and sel_ano_str.isdigit() else None
    sel_mes = int(sel_mes_str) if sel_mes_str and sel_mes_str.isdigit() else None

    # --- 3. NÍVEL SELECIONADO ---
    nivel_sel = request.GET.get("nivel")
    if nivel_sel and nivel_sel not in dict(NivelChoices.choices):
        nivel_sel = None

    # --- 4. CARDS (Menu Superior) ---
    ICON_MAP = {
        "FECHAMENTO": "ic_fechamento.svg",
        "SIGA": "ic_siga.svg",
        "E-TCM": "ic_etcm.svg",
        "SIOPE": "ic_siope.svg",
        "SIOPS": "ic_siops.svg",
        "SICONF": "ic_siconf.svg",
    }

    try: perfil = user.perfil
    except (AttributeError, UsuarioPerfil.DoesNotExist): perfil = None

    def tem_permissao(nivel_key):
        if user.is_superuser: return True
        if not perfil: return False
        mapa = {
            "FECHAMENTO": perfil.acesso_fechamento,
            "SIGA": perfil.acesso_siga,
            "E-TCM": perfil.acesso_etcm,
            "SIOPE": perfil.acesso_siope,
            "SIOPS": perfil.acesso_siops,
            "SICONF": perfil.acesso_siconf,
        }
        return mapa.get(nivel_key, False)

    niveis = []
    for val, label in NivelChoices.choices:
        if tem_permissao(val):
            niveis.append({
                "key": val,
                "label": label,
                "icon": ICON_MAP.get(val, "ic_default.svg"),
                "is_active": (val == nivel_sel),
            })

    # --- 5. DADOS DOS CLIENTES (Somente se data e nível selecionados) ---
    clientes_data = []

    if nivel_sel and sel_ano and sel_mes:
        mapa_obrigatoriedade = {
            "SIGA": "obrigatoria_para_fila_siga",
            "E-TCM": "obrigatoria_para_fila_etcm",
            "SIOPE": "obrigatoria_para_fila_siope",
            "SIOPS": "obrigatoria_para_fila_siops",
            "SICONF": "obrigatoria_para_fila_siconf",
        }

        assoc_ids = AssociacaoUsuarioCliente.objects.filter(usuario=user, ativo=True).values_list("cliente_id", flat=True)
        clientes_qs = Cliente.objects.filter(id__in=assoc_ids, ativo=True).order_by("nome")

        etapas_do_nivel = Etapa.objects.filter(nivel=nivel_sel, ativa=True)
        total_etapas = etapas_do_nivel.count()
        campo_filtro = mapa_obrigatoriedade.get(nivel_sel)
        hoje = now()

        for c in clientes_qs:
            # Lógica de Bloqueio
            data_liberacao = None
            is_desbloqueado = True

            if nivel_sel != "FECHAMENTO" and campo_filtro:
                etapas_requisito = Etapa.objects.filter(ativa=True, **{campo_filtro: True})
                total_requisitos = etapas_requisito.count()

                if total_requisitos > 0:
                    regs_concluidos = EtapaRegistro.objects.filter(
                        cliente=c, ano=sel_ano, mes=sel_mes,
                        etapa__in=etapas_requisito, status=EtapaRegistroStatus.CONCLUIDO
                    )
                    if regs_concluidos.count() < total_requisitos:
                        is_desbloqueado = False
                    else:
                        agregado = regs_concluidos.aggregate(max_data=Max('modificado_em'))
                        data_liberacao = agregado['max_data'] or hoje

            if not is_desbloqueado:
                continue

            # Progresso
            concluidas = EtapaRegistro.objects.filter(
                cliente=c, ano=sel_ano, mes=sel_mes,
                etapa__in=etapas_do_nivel, status=EtapaRegistroStatus.CONCLUIDO
            ).count()

            ultimo_reg = EtapaRegistro.objects.filter(
                cliente=c, ano=sel_ano, mes=sel_mes, etapa__in=etapas_do_nivel
            ).select_related('ultima_alteracao_por').order_by('-modificado_em').first()

            ultimo_editor_nome = None
            ultima_data_alteracao = None
            if ultimo_reg:
                 ultima_data_alteracao = ultimo_reg.modificado_em
                 if ultimo_reg.ultima_alteracao_por:
                     ultimo_editor_nome = ultimo_reg.ultima_alteracao_por.get_full_name() or ultimo_reg.ultima_alteracao_por.username

            if total_etapas == 0: status_geral = "Sem etapas"
            elif concluidas >= total_etapas: status_geral = "Concluído"
            elif concluidas > 0: status_geral = "Em andamento"
            else: status_geral = "Não iniciado"

            clientes_data.append({
                "cliente": c,
                "qtd_etapas": total_etapas,
                "qtd_concluidas": concluidas,
                "qtd_pendente": total_etapas - concluidas,
                "status_geral": status_geral,
                "ultimo_editor": ultimo_editor_nome,
                "ultima_data": ultima_data_alteracao,
                "data_liberacao": data_liberacao,
            })

        # Ordenação
        if nivel_sel == "FECHAMENTO":
            clientes_data.sort(key=lambda x: x['qtd_concluidas'], reverse=True)
        else:
            clientes_data.sort(key=lambda x: x['data_liberacao'] or hoje)

    # --- 6. DADOS ADMINISTRATIVOS (Modais) ---
    todos_clientes_modal = []
    gestao_etapas_dict = {}
    form_etapa = None
    solicitacoes_pendentes = []
    qtd_solicitacoes = 0

    if request.user.is_staff or request.user.is_superuser:
        todos_clientes_modal = Cliente.objects.filter(ativo=True).order_by("nome")

        form_etapa = EtapaForm()
        todas_etapas = Etapa.objects.all().order_by('nivel', 'ordem')
        for nivel, _ in NivelChoices.choices:
            gestao_etapas_dict[nivel] = todas_etapas.filter(nivel=nivel)

        solicitacoes_pendentes = SolicitacaoReabertura.objects.filter(status='PENDENTE')\
            .select_related('registro', 'registro__cliente', 'registro__etapa', 'solicitante')\
            .annotate(tentativas=Count('registro__solicitacoes'))
        qtd_solicitacoes = solicitacoes_pendentes.count()

    context = {
        # Contexto Dashboard Pessoal (Novo)
        "tem_aprovadas": tem_aprovadas,
        "checklist_form": checklist_form,
        "checklist_pendentes": checklist_pendentes,
        "vapid_public_key": settings.WEBPUSH_SETTINGS["VAPID_PUBLIC_KEY"],

        # Contexto Atividades
        "sel_ano": sel_ano,
        "sel_mes": sel_mes,
        "nivel_sel": nivel_sel,
        "niveis": niveis,
        "clientes_data": clientes_data,
        "meses_numeros": range(1, 13),

        # Contexto Admin
        "todos_clientes_modal": todos_clientes_modal,
        "gestao_etapas_dict": gestao_etapas_dict,
        "form_etapa": form_etapa,
        "NivelChoices": NivelChoices,
        "solicitacoes_pendentes": solicitacoes_pendentes,
        "qtd_solicitacoes": qtd_solicitacoes,
    }
    return render(request, "atividades/home.html", context)
'''

from django.urls import reverse # Certifique-se de importar isso

@login_required
def etapa_salvar(request):
    """Salva uma nova etapa ou edita existente via POST"""
    if not (request.user.is_staff or request.user.is_superuser):
        return HttpResponseForbidden()

    nivel_retorno = "FECHAMENTO" # Padrão caso algo falhe

    if request.method == 'POST':
        etapa_id = request.POST.get('etapa_id')

        # Captura o nível enviado no form para manter a aba aberta
        nivel_retorno = request.POST.get('nivel', 'FECHAMENTO')

        if etapa_id:
            etapa = get_object_or_404(Etapa, id=etapa_id)
            form = EtapaForm(request.POST, instance=etapa)
        else:
            form = EtapaForm(request.POST)

        if form.is_valid():
            etapa_salva = form.save()
            # Atualiza o nível de retorno com o real gravado no banco (segurança)
            nivel_retorno = etapa_salva.nivel

    # Monta a URL com os parâmetros para reabrir o modal
    base_url = reverse('atividades_home')
    return redirect(f"{base_url}?gerenciar_etapas=1&aba_ativa={nivel_retorno}")

@login_required
def etapa_excluir(request, etapa_id):
    """Realiza a exclusão lógica (desativação) da etapa."""
    if not (request.user.is_staff or request.user.is_superuser):
        return HttpResponseForbidden()

    etapa = get_object_or_404(Etapa, id=etapa_id)
    nivel_atual = etapa.nivel # Guarda o nível antes de salvar

    etapa.ativa = False
    etapa.save()

    base_url = reverse('atividades_home')
    return redirect(f"{base_url}?gerenciar_etapas=1&aba_ativa={nivel_atual}")


from django.utils import timezone # <--- Importante para corrigir o horário

@login_required
def relatorio_administrativo(request):
    """
    Gera o relatório sintetizado com múltiplos níveis por cliente.
    """
    if not (request.user.is_staff or request.user.is_superuser):
        return HttpResponseForbidden("Apenas administradores.")

    ids_clientes = request.GET.getlist('clientes')
    try: sel_mes = int(request.GET.get('mes'))
    except: sel_mes = now().month
    try: sel_ano = int(request.GET.get('ano'))
    except: sel_ano = now().year

    clientes = Cliente.objects.filter(id__in=ids_clientes, ativo=True)

    # 1. AJUSTE: Adicionado FECHAMENTO no topo da lista
    NIVEIS_EXIBICAO = [
        ("FECHAMENTO", "FECHAMENTO"),
        ("SIGA", "SIGA"),
        ("SIOPE", "SIOPE"),
        ("SIOPS", "SIOPS"),
        ("SICONF", "SICONFI"),
        ("E_TCM", "E-TCM"),
    ]

    relatorio_data = []

    for c in clientes:
        status_niveis = []

        for nivel_key, nivel_label in NIVEIS_EXIBICAO:
            etapas = Etapa.objects.filter(nivel=nivel_key, ativa=True)
            total = etapas.count()

            concluidas = EtapaRegistro.objects.filter(
                cliente=c, ano=sel_ano, mes=sel_mes,
                etapa__in=etapas, status=EtapaRegistroStatus.CONCLUIDO
            ).count()

            ultimo_reg = EtapaRegistro.objects.filter(
                cliente=c, ano=sel_ano, mes=sel_mes, etapa__in=etapas
            ).select_related('ultima_alteracao_por').order_by('-modificado_em').first()

            status_texto = "não iniciado"
            css_class = "nao"

            if total > 0:
                if concluidas >= total:
                    status_texto = "Concluído"
                    css_class = "concluido"
                elif concluidas > 0:
                    status_texto = "Em andamento"
                    css_class = "pendente"

            info_meta = ""
            if ultimo_reg and css_class != "nao":
                autor = ultimo_reg.ultima_alteracao_por
                nome = autor.get_full_name() if autor else "Sistema"
                if not nome and autor: nome = autor.username

                # 2. AJUSTE: Correção do Fuso Horário
                # Converte o horário UTC do banco para o horário local configurado no settings.py
                data_local = timezone.localtime(ultimo_reg.modificado_em)
                data_fmt = data_local.strftime("%d/%m/%Y, às %H:%Mh")

                info_meta = f"por {nome}, {data_fmt}"

            status_niveis.append({
                "label": nivel_label,
                "status": status_texto,
                "css_class": css_class,
                "meta": info_meta
            })

        relatorio_data.append({
            "cliente": c,
            "niveis": status_niveis
        })

    context = {
        "relatorio_data": relatorio_data,
        "sel_mes": sel_mes,
        "sel_ano": sel_ano,
        "query_string": request.GET.urlencode()
    }
    return render(request, "atividades/relatorio_administrativo.html", context)

