'''
# ANTERIOR - CONSIDERA APENAS O FECHAMENTO
def verificar_nivel_desbloqueado(cliente, ano, mes, nivel_alvo):
    """
    Retorna True se o cliente cumpriu os requisitos no FECHAMENTO para acessar o nivel_alvo.
    """
    # FECHAMENTO está sempre liberado
    if nivel_alvo == NivelChoices.FECHAMENTO:
        return True

    # Mapeamento: Qual campo do model Etapa indica obrigatoriedade para este nível?
    mapa_obrigatoriedade = {
        NivelChoices.SIGA: "obrigatoria_para_fila_siga",
        NivelChoices.E_TCM: "obrigatoria_para_fila_etcm",
        NivelChoices.SIOPE: "obrigatoria_para_fila_siope",
        NivelChoices.SIOPS: "obrigatoria_para_fila_siops",
        NivelChoices.SICONF: "obrigatoria_para_fila_siconf",
    }

    campo_filtro = mapa_obrigatoriedade.get(nivel_alvo)

    # Se não houver requisito mapeado, assume liberado (ou mude para False se quiser ser restritivo)
    if not campo_filtro:
        return True

    # 1. Busca etapas do FECHAMENTO que são obrigatórias para este nível
    filtro_kwargs = {
        "nivel": NivelChoices.FECHAMENTO,
        "ativa": True,
        campo_filtro: True
    }
    etapas_requisito = Etapa.objects.filter(**filtro_kwargs)
    total_requisitos = etapas_requisito.count()

    # Se não tem requisitos, está liberado
    if total_requisitos == 0:
        return True

    # 2. Verifica quantas estão concluídas
    concluidas = EtapaRegistro.objects.filter(
        cliente=cliente,
        ano=ano,
        mes=mes,
        etapa__in=etapas_requisito,
        status=EtapaRegistroStatus.CONCLUIDO
    ).count()

    return concluidas >= total_requisitos
'''
#antiga
'''
def verificar_nivel_desbloqueado(cliente, ano, mes, nivel_alvo):
    """
    Verifica a 'Soma de Requisitos Cross-Module'.

    Retorna uma tupla: (esta_desbloqueado: bool, lista_nomes_pendentes: list)

    Args:
        cliente: Instância do modelo Cliente
        ano: Ano da competência (int)
        mes: Mês da competência (int)
        nivel_alvo: String com o nível (ex: "SIGA", "SIOPS", etc.)

    Returns:
        tuple: (bool, list) onde:
            - bool: True se todos os requisitos estão atendidos, False caso contrário
            - list: Lista de strings com os nomes das etapas pendentes
    """
    from .models import Etapa, EtapaRegistro, EtapaRegistroStatus

    # 1. Mapeia o nível alvo para o campo booleano da Etapa
    # IMPORTANTE: As chaves devem ser strings, não enums
    mapa_campos = {
        "SIGA": "obrigatoria_para_fila_siga",
        "E-TCM": "obrigatoria_para_fila_etcm",
        "SIOPE": "obrigatoria_para_fila_siope",
        "SIOPS": "obrigatoria_para_fila_siops",
        "SICONF": "obrigatoria_para_fila_siconf",
    }

    # Garantir que nivel_alvo é string
    nivel_alvo_str = str(nivel_alvo).strip()
    campo_filtro = mapa_campos.get(nivel_alvo_str)

    # Se o nível não tem requisitos específicos (ex: FECHAMENTO), está livre
    if not campo_filtro:
        return (True, [])

    # 2. Busca TODAS as etapas do sistema que travam este nível
    # Isso garante a "Soma de Requisitos" independente de onde a etapa esteja
    # (pode ser do FECHAMENTO, SIGA, ou qualquer outro nível)
    etapas_requisito = Etapa.objects.filter(ativa=True, **{campo_filtro: True})

    total_requisitos = etapas_requisito.count()

    # Se não há requisitos, está liberado
    if total_requisitos == 0:
        return (True, [])

    # 3. Verifica quais dessas foram concluídas para este cliente/competência
    ids_requisitos = set(etapas_requisito.values_list('id', flat=True))

    ids_concluidos = set(
        EtapaRegistro.objects.filter(
            cliente=cliente,
            ano=ano,
            mes=mes,
            etapa_id__in=ids_requisitos,
            status=EtapaRegistroStatus.CONCLUIDO
        ).values_list('etapa_id', flat=True)
    )

    # 4. Calcula pendências
    ids_pendentes = ids_requisitos - ids_concluidos

    # 5. A Regra de Ouro: Só desbloqueia se TODAS as obrigatórias estiverem concluídas
    esta_liberado = (len(ids_pendentes) == 0)

    # 6. Busca os nomes das etapas pendentes para exibir ao usuário
    lista_nomes_pendentes = []
    if ids_pendentes:
        lista_nomes_pendentes = list(
            Etapa.objects.filter(id__in=ids_pendentes)
            .values_list('nome', flat=True)
            .order_by('ordem', 'nome')
        )

    return (esta_liberado, lista_nomes_pendentes)
'''


def verificar_nivel_desbloqueado(cliente, ano, mes, nivel):
    """
    Versão atualizada que considera liberação por cliente específico.

    Retorna: (bool, lista_pendencias)
    """
    from .models import (
        ConfiguracaoNivel,
        Etapa,
        EtapaRegistro,
        EtapaRegistroStatus
    )

    # 1. Verifica se existe configuração para este nível
    try:
        config = ConfiguracaoNivel.objects.get(nivel=nivel)

        # Usa o método do modelo para verificar liberação
        if config.esta_liberado_para_cliente(cliente):
            return True, []

    except ConfiguracaoNivel.DoesNotExist:
        # Se não existe configuração, segue para verificação de requisitos
        pass

    # 2. Se não está liberado por configuração, verifica requisitos
    motivos = []

    mapa_flags = {
        "SIGA": "obrigatoria_para_fila_siga",
        "E-TCM": "obrigatoria_para_fila_etcm",
        "SIOPE": "obrigatoria_para_fila_siope",
        "SIOPS": "obrigatoria_para_fila_siops",
        "SICONF": "obrigatoria_para_fila_siconf",
    }

    campo_flag = mapa_flags.get(nivel)

    if campo_flag:
        etapas_exigidas = Etapa.objects.filter(
            ativa=True,
            **{campo_flag: True}
        )

        for etapa_req in etapas_exigidas:
            registro_req = EtapaRegistro.objects.filter(
                cliente=cliente,
                etapa=etapa_req,
                ano=ano,
                mes=mes
            ).first()

            if not registro_req or registro_req.status != EtapaRegistroStatus.CONCLUIDO:
                motivos.append(etapa_req.nome)

    if motivos:
        return False, motivos

    return True, []

def fechamento_esta_fechado(cliente, ano, mes):
    """Verifica se o fechamento (geral) está concluído."""
    return verificar_nivel_desbloqueado(cliente, ano, mes, "ALL_CHECK") # Simplificação ou manter sua lógica antiga


