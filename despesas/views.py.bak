from django.shortcuts import render
from django.contrib.auth.decorators import login_required
from django.utils.timezone import now
from django.db.models import Max
from datetime import datetime, timedelta

# --- 1. IMPORTS DE MODELOS E FORMS ---
from .models import (
    Despesa, ChecklistItem, NivelChoices,
    ConfiguracaoNivel, AssociacaoUsuarioCliente, Cliente,
    Etapa, EtapaRegistro, EtapaRegistroStatus, UsuarioPerfil,
    SolicitacaoReabertura
)

# Tratamento para evitar erro de importação se o arquivo forms.py variar
try:
    from .forms import ChecklistForm, EtapaForm
except ImportError:
    ChecklistForm = None
    EtapaForm = None

# --- 2. HELPERS (FUNÇÕES AUXILIARES) ---

def get_nivel_anterior(nivel_atual):
    """Retorna o nível pré-requisito imediato (cadeia de dependência)."""
    # Defina aqui a sua regra de negócio "Cascata"
    cadeia = {
        NivelChoices.SIGA: NivelChoices.FECHAMENTO,
        NivelChoices.E_TCM: NivelChoices.SIGA,
        NivelChoices.SIOPE: NivelChoices.FECHAMENTO, # Exemplo: SIOPE depende do Fechamento
        NivelChoices.SIOPS: NivelChoices.FECHAMENTO,
        NivelChoices.SICONF: NivelChoices.FECHAMENTO,
    }
    return cadeia.get(nivel_atual)

